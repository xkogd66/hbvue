{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport ImageOverlay from \"@/components/ImageOverlay\";\nexport default {\n  props: {\n    month: {\n      type: Number,\n      required: true\n    },\n    year: {\n      type: Number,\n      required: true\n    }\n  },\n  data() {\n    return {\n      imageUrls: [],\n      showOverlay: false,\n      selectedImage: \"\",\n      selectedDate: \"\",\n      selectedIndex: 0,\n      isLoading: true\n    };\n  },\n  components: {\n    ImageOverlay\n  },\n  mounted() {\n    this.fetchImages();\n  },\n  watch: {\n    month: 'fetchImages',\n    year: 'fetchImages'\n  },\n  methods: {\n    fetchImages() {\n      this.isLoading = true;\n      this.imageUrls = [];\n      const today = new Date();\n      const currentYear = today.getFullYear();\n      const currentMonth = today.getMonth() + 1;\n      const currentDay = today.getDate() - 1;\n      const lastDay = new Date(this.year, this.month, 0).getDate();\n\n      // this.startDay = (this.year === 2010 && this.month === 3) ? 11 : 1;\n      this.startDay = 1;\n      for (let day = this.startDay; day <= lastDay; day++) {\n        const formattedDay = day < 10 ? `0${day}` : `${day}`;\n        const formattedMonth = this.month < 10 ? `0${this.month}` : `${this.month}`;\n\n        // Check if the date is in the future\n        const isFutureDate = this.year > currentYear || this.year === currentYear && this.month > currentMonth || this.year === currentYear && this.month === currentMonth && day > currentDay;\n        this.imageUrls.push({\n          url: isFutureDate ? null : `https://objects.ekskog.net/blotpix/${this.year}/${formattedMonth}/${formattedDay}.jpeg`,\n          day: day\n        });\n      }\n      this.isLoading = false;\n    },\n    getMonthName(month) {\n      const monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\n      return monthNames[month - 1] || '';\n    },\n    formatDate(day) {\n      if (!day || isNaN(day)) {\n        console.error(\"Invalid day passed to formatDate:\", day);\n        return \"Invalid Date\";\n      }\n      const monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\n      const suffixes = [\"st\", \"nd\", \"rd\", \"th\"];\n      let suffix;\n      if (day >= 11 && day <= 13) {\n        suffix = suffixes[3];\n      } else {\n        switch (day % 10) {\n          case 1:\n            suffix = suffixes[0];\n            break;\n          case 2:\n            suffix = suffixes[1];\n            break;\n          case 3:\n            suffix = suffixes[2];\n            break;\n          default:\n            suffix = suffixes[3];\n        }\n      }\n      return `${monthNames[this.month - 1]} ${day}${suffix}, ${this.year}`;\n    },\n    goHome() {\n      this.$emit('home');\n    },\n    previous() {\n      const previousMonth = this.month === 1 ? 12 : this.month - 1;\n      const previousYear = this.month === 1 ? this.year - 1 : this.year;\n      this.$emit('navigate', {\n        month: previousMonth,\n        year: previousYear\n      });\n    },\n    next() {\n      const nextMonth = this.month === 12 ? 1 : this.month + 1;\n      const nextYear = this.month === 12 ? this.year + 1 : this.year;\n      this.$emit('navigate', {\n        month: nextMonth,\n        year: nextYear\n      });\n    },\n    openImageOverlay(index) {\n      this.selectedIndex = index;\n      this.selectedImage = this.imageUrls[index].url; // Change this line\n      this.selectedDate = this.formatDate(this.imageUrls[index].day);\n      this.showOverlay = true;\n    },\n    closeOverlay() {\n      this.showOverlay = false;\n      this.selectedImage = \"\";\n      this.selectedDate = \"\";\n      this.selectedIndex = 0;\n    },\n    prvImg() {\n      if (this.selectedIndex > 0) {\n        this.selectedIndex--;\n        this.selectedImage = this.imageUrls[this.selectedIndex].url;\n        this.selectedDate = this.formatDate(this.imageUrls[this.selectedIndex].day);\n      } else {\n        alert(\"This is the first available image for this month.\");\n      }\n    },\n    nxtImg() {\n      if (this.selectedIndex < this.imageUrls.length - 1) {\n        this.selectedIndex++;\n        this.selectedImage = this.imageUrls[this.selectedIndex].url;\n        this.selectedDate = this.formatDate(this.imageUrls[this.selectedIndex].day);\n      } else {\n        alert(\"This is the last available image for this month.\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["ImageOverlay","props","month","type","Number","required","year","data","imageUrls","showOverlay","selectedImage","selectedDate","selectedIndex","isLoading","components","mounted","fetchImages","watch","methods","today","Date","currentYear","getFullYear","currentMonth","getMonth","currentDay","getDate","lastDay","startDay","day","formattedDay","formattedMonth","isFutureDate","push","url","getMonthName","monthNames","formatDate","isNaN","console","error","suffixes","suffix","goHome","$emit","previous","previousMonth","previousYear","next","nextMonth","nextYear","openImageOverlay","index","closeOverlay","prvImg","alert","nxtImg","length"],"sources":["/Users/lucarv/Documents/Repos/hbvue/src/components/ImageGrid.vue"],"sourcesContent":["<template>\n    <div class=\"max-w-[1200px] mx-auto p-5\">\n        <div class=\"flex items-center justify-between mb-5\">\n            <button class=\"bg-green-500 text-white border-none px-4 py-2.5 rounded cursor-pointer hover:bg-green-600\" @click=\"goHome\">\n                <i class=\"fas fa-home\"></i>\n            </button>\n            <div class=\"flex flex-col items-center\">\n                <div class=\"text-2xl font-bold\">\n                    <span class=\"cursor-pointer px-2.5\" @click=\"previous\">&larr;</span>\n                    {{ getMonthName(month) }} {{ year }}\n                    <span class=\"cursor-pointer px-2.5\" @click=\"next\">&rarr;</span>\n                </div>\n                <div class=\"text-center mt-1 text-sm text-gray-600\">Click on the thumbnails for a full-size image</div>\n            </div>\n        </div>\n        <div class=\"grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-5\">\n            <div v-if=\"isLoading\" class=\"col-span-full text-center p-5 text-lg text-gray-600\">Loading images...</div>\n            <div v-else-if=\"imageUrls.length === 0\" class=\"col-span-full text-center p-5 text-lg text-gray-600\">No images available for this period.</div>\n            <div v-for=\"(image, index) in imageUrls\" :key=\"index\" class=\"border border-gray-300 rounded-lg overflow-hidden shadow-sm\">\n                <div class=\"w-full h-0 pb-[100%] relative cursor-pointer\" @click=\"openImageOverlay(index)\">\n                    <img :src=\"imageUrl\" alt=\"Thumbnail\" class=\"absolute w-full h-full object-cover\" />\n                </div>\n                <div class=\"p-2 text-center bg-gray-100 text-xs text-gray-700 font-sans\">{{ formatDate(image.day) }}</div>\n            </div>\n        </div>\n        <ImageOverlay v-if=\"showOverlay\" :showOverlay=\"showOverlay\" :selectedImage=\"selectedImage\" :selectedDate=\"selectedDate\"\n            @close-overlay=\"closeOverlay\" @prvImg=\"prvImg\" @nxtImg=\"nxtImg\" />\n    </div>\n</template>\n\n\n<script>\nimport ImageOverlay from \"@/components/ImageOverlay\";\n\nexport default {\n    props: {\n        month: {\n            type: Number,\n            required: true,\n        },\n        year: {\n            type: Number,\n            required: true,\n        },\n    },\n    data() {\n        return {\n            imageUrls: [],\n            showOverlay: false,\n            selectedImage: \"\",\n            selectedDate: \"\",\n            selectedIndex: 0,\n            isLoading: true,\n        };\n    },\n    components: {\n        ImageOverlay\n    },\n    mounted() {\n        this.fetchImages();\n    },\n    watch: {\n        month: 'fetchImages',\n        year: 'fetchImages',\n    },\n    methods: {\n        fetchImages() {\n            this.isLoading = true;\n            this.imageUrls = [];\n\n            const today = new Date();\n            const currentYear = today.getFullYear();\n            const currentMonth = today.getMonth() + 1;\n            const currentDay = today.getDate() - 1;\n\n            const lastDay = new Date(this.year, this.month, 0).getDate();\n\n            // this.startDay = (this.year === 2010 && this.month === 3) ? 11 : 1;\n            this.startDay = 1;\n\n            for (let day = this.startDay; day <= lastDay; day++) {\n                const formattedDay = day < 10 ? `0${day}` : `${day}`;\n                const formattedMonth = this.month < 10 ? `0${this.month}` : `${this.month}`;\n\n                // Check if the date is in the future\n                const isFutureDate =\n                    this.year > currentYear ||\n                    (this.year === currentYear && this.month > currentMonth) ||\n                    (this.year === currentYear && this.month === currentMonth && day > currentDay);\n\n                this.imageUrls.push({\n                    url: isFutureDate ? null : `https://objects.ekskog.net/blotpix/${this.year}/${formattedMonth}/${formattedDay}.jpeg`,\n                    day: day\n                });\n            }\n\n            this.isLoading = false;\n        },\n        getMonthName(month) {\n            const monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\n            return monthNames[month - 1] || '';\n        },\n        formatDate(day) {\n            if (!day || isNaN(day)) {\n                console.error(\"Invalid day passed to formatDate:\", day);\n                return \"Invalid Date\";\n            }\n\n            const monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\n            const suffixes = [\"st\", \"nd\", \"rd\", \"th\"];\n\n            let suffix;\n            if (day >= 11 && day <= 13) {\n                suffix = suffixes[3];\n            } else {\n                switch (day % 10) {\n                    case 1: suffix = suffixes[0]; break;\n                    case 2: suffix = suffixes[1]; break;\n                    case 3: suffix = suffixes[2]; break;\n                    default: suffix = suffixes[3];\n                }\n            }\n\n            return `${monthNames[this.month - 1]} ${day}${suffix}, ${this.year}`;\n        },\n        goHome() {\n            this.$emit('home');\n        },\n        previous() {\n            const previousMonth = this.month === 1 ? 12 : this.month - 1;\n            const previousYear = this.month === 1 ? this.year - 1 : this.year;\n            this.$emit('navigate', { month: previousMonth, year: previousYear });\n        },\n        next() {\n            const nextMonth = this.month === 12 ? 1 : this.month + 1;\n            const nextYear = this.month === 12 ? this.year + 1 : this.year;\n            this.$emit('navigate', { month: nextMonth, year: nextYear });\n        },\n        openImageOverlay(index) {\n            this.selectedIndex = index;\n            this.selectedImage = this.imageUrls[index].url; // Change this line\n            this.selectedDate = this.formatDate(this.imageUrls[index].day);\n            this.showOverlay = true;\n        },\n        closeOverlay() {\n            this.showOverlay = false;\n            this.selectedImage = \"\";\n            this.selectedDate = \"\";\n            this.selectedIndex = 0;\n        },\n        prvImg() {\n            if (this.selectedIndex > 0) {\n                this.selectedIndex--;\n                this.selectedImage = this.imageUrls[this.selectedIndex].url;\n                this.selectedDate = this.formatDate(this.imageUrls[this.selectedIndex].day);\n            } else {\n                alert(\"This is the first available image for this month.\");\n            }\n        },\n\n        nxtImg() {\n            if (this.selectedIndex < this.imageUrls.length - 1) {\n                this.selectedIndex++;\n                this.selectedImage = this.imageUrls[this.selectedIndex].url;\n                this.selectedDate = this.formatDate(this.imageUrls[this.selectedIndex].day);\n            } else {\n                alert(\"This is the last available image for this month.\");\n            }\n        },\n    },\n};\n</script>"],"mappings":";AAgCA,OAAOA,YAAW,MAAO,2BAA2B;AAEpD,eAAe;EACXC,KAAK,EAAE;IACHC,KAAK,EAAE;MACHC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACd,CAAC;IACDC,IAAI,EAAE;MACFH,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDE,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,SAAS,EAAE,EAAE;MACbC,WAAW,EAAE,KAAK;MAClBC,aAAa,EAAE,EAAE;MACjBC,YAAY,EAAE,EAAE;MAChBC,aAAa,EAAE,CAAC;MAChBC,SAAS,EAAE;IACf,CAAC;EACL,CAAC;EACDC,UAAU,EAAE;IACRd;EACJ,CAAC;EACDe,OAAOA,CAAA,EAAG;IACN,IAAI,CAACC,WAAW,CAAC,CAAC;EACtB,CAAC;EACDC,KAAK,EAAE;IACHf,KAAK,EAAE,aAAa;IACpBI,IAAI,EAAE;EACV,CAAC;EACDY,OAAO,EAAE;IACLF,WAAWA,CAAA,EAAG;MACV,IAAI,CAACH,SAAQ,GAAI,IAAI;MACrB,IAAI,CAACL,SAAQ,GAAI,EAAE;MAEnB,MAAMW,KAAI,GAAI,IAAIC,IAAI,CAAC,CAAC;MACxB,MAAMC,WAAU,GAAIF,KAAK,CAACG,WAAW,CAAC,CAAC;MACvC,MAAMC,YAAW,GAAIJ,KAAK,CAACK,QAAQ,CAAC,IAAI,CAAC;MACzC,MAAMC,UAAS,GAAIN,KAAK,CAACO,OAAO,CAAC,IAAI,CAAC;MAEtC,MAAMC,OAAM,GAAI,IAAIP,IAAI,CAAC,IAAI,CAACd,IAAI,EAAE,IAAI,CAACJ,KAAK,EAAE,CAAC,CAAC,CAACwB,OAAO,CAAC,CAAC;;MAE5D;MACA,IAAI,CAACE,QAAO,GAAI,CAAC;MAEjB,KAAK,IAAIC,GAAE,GAAI,IAAI,CAACD,QAAQ,EAAEC,GAAE,IAAKF,OAAO,EAAEE,GAAG,EAAE,EAAE;QACjD,MAAMC,YAAW,GAAID,GAAE,GAAI,EAAC,GAAK,IAAGA,GAAI,KAAK,GAAEA,GAAI,EAAC;QACpD,MAAME,cAAa,GAAI,IAAI,CAAC7B,KAAI,GAAI,EAAC,GAAK,IAAG,IAAI,CAACA,KAAM,KAAK,GAAE,IAAI,CAACA,KAAM,EAAC;;QAE3E;QACA,MAAM8B,YAAW,GACb,IAAI,CAAC1B,IAAG,GAAIe,WAAU,