{"ast":null,"code":"export default {\n  props: {\n    showOverlay: {\n      type: Boolean,\n      required: true,\n      selectedImage: String,\n      selectedDate: String\n    },\n    selectedImage: {\n      type: String,\n      required: true\n    },\n    selectedDate: {\n      type: String,\n      required: true\n    }\n  },\n  methods: {\n    closeImageOverlay() {\n      this.$emit(\"close-overlay\");\n    },\n    prvImg() {\n      this.$emit(\"prvImg\");\n    },\n    nxtImg() {\n      this.$emit(\"nxtImg\");\n    },\n    handleEscapeKey(event) {\n      if (event.key === \"Escape\") this.$emit(\"close-overlay\");\n    }\n  },\n  mounted() {\n    document.addEventListener(\"keydown\", this.handleEscapeKey);\n    console.log(\"ImageOverlay mounted with date:\", this.selectedDate);\n  },\n  unmounted() {\n    document.removeEventListener(\"keydown\", this.handleEscapeKey);\n  }\n};","map":{"version":3,"names":["props","showOverlay","type","Boolean","required","selectedImage","String","selectedDate","methods","closeImageOverlay","$emit","prvImg","nxtImg","handleEscapeKey","event","key","mounted","document","addEventListener","console","log","unmounted","removeEventListener"],"sources":["/Users/lucarv/Documents/Repos/hbvue/src/components/ImageOverlay.vue"],"sourcesContent":["<template>\r\n  <div class=\"image-overlay\" v-if=\"showOverlay\">\r\n    <div class=\"image-card\">\r\n      <img :src=\"selectedImage\" alt=\"Full Image\" />\r\n      <div class=\"image-footer\">{{ selectedDate }}\r\n      </div>\r\n    </div>\r\n    <div class=\"buttons-container\">\r\n      <span class=\"overlay-button\" @click=\"prvImg\">previous</span>\r\n      <span class=\"overlay-button\" @click=\"closeImageOverlay\">back</span>\r\n      <span class=\"overlay-button\" @click=\"nxtImg\">next</span>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  props: {\r\n    showOverlay: {\r\n      type: Boolean,\r\n      required: true,\r\n      selectedImage: String,\r\n      selectedDate: String,\r\n    },\r\n    selectedImage: {\r\n      type: String,\r\n      required: true,\r\n    },\r\n    selectedDate: {\r\n      type: String,\r\n      required: true,\r\n    },\r\n  },\r\n  methods: {\r\n    closeImageOverlay() {\r\n      this.$emit(\"close-overlay\");\r\n    },\r\n    prvImg() {\r\n      this.$emit(\"prvImg\");\r\n    },\r\n    nxtImg() {\r\n      this.$emit(\"nxtImg\");\r\n    },\r\n    handleEscapeKey(event) {\r\n      if (event.key === \"Escape\") this.$emit(\"close-overlay\");\r\n    },\r\n  },\r\n  mounted() {\r\n    document.addEventListener(\"keydown\", this.handleEscapeKey);\r\n    console.log(\"ImageOverlay mounted with date:\", this.selectedDate);\r\n  },\r\n  unmounted() {\r\n    document.removeEventListener(\"keydown\", this.handleEscapeKey);\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.image-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.8);\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 1000;\r\n}\r\n\r\n.image-card {\r\n  background-color: white;\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);\r\n  max-width: 90%;\r\n  max-height: 90%;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.image-card img {\r\n  max-width: 100%;\r\n  max-height: calc(90vh - 60px);\r\n  object-fit: contain;\r\n}\r\n\r\n.image-footer {\r\n  padding: 15px;\r\n  text-align: center;\r\n  background-color: #f8f8f8;\r\n  font-size: 16px;\r\n  color: #333;\r\n  font-family: Verdana, sans-serif;\r\n}\r\n\r\n.buttons-container {\r\n  margin-top: 20px;\r\n  display: flex;\r\n  justify-content: center;\r\n  width: 100%;\r\n}\r\n\r\n.overlay-button {\r\n  margin: 0 10px;\r\n  color: white;\r\n  font-size: 18px;\r\n  cursor: pointer;\r\n  background-color: rgba(255, 255, 255, 0.2);\r\n  padding: 10px 15px;\r\n  border-radius: 8px;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.overlay-button:hover {\r\n  background-color: rgba(255, 255, 255, 0.3);\r\n}\r\n\r\n.overlay-button:active {\r\n  background-color: rgba(255, 255, 255, 0.4);\r\n}\r\n</style>"],"mappings":"AAgBA,eAAe;EACbA,KAAK,EAAE;IACLC,WAAW,EAAE;MACXC,IAAI,EAAEC,OAAO;MACbC,QAAQ,EAAE,IAAI;MACdC,aAAa,EAAEC,MAAM;MACrBC,YAAY,EAAED;IAChB,CAAC;IACDD,aAAa,EAAE;MACbH,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ,CAAC;IACDG,YAAY,EAAE;MACZL,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ;EACF,CAAC;EACDI,OAAO,EAAE;IACPC,iBAAiBA,CAAA,EAAG;MAClB,IAAI,CAACC,KAAK,CAAC,eAAe,CAAC;IAC7B,CAAC;IACDC,MAAMA,CAAA,EAAG;MACP,IAAI,CAACD,KAAK,CAAC,QAAQ,CAAC;IACtB,CAAC;IACDE,MAAMA,CAAA,EAAG;MACP,IAAI,CAACF,KAAK,CAAC,QAAQ,CAAC;IACtB,CAAC;IACDG,eAAeA,CAACC,KAAK,EAAE;MACrB,IAAIA,KAAK,CAACC,GAAE,KAAM,QAAQ,EAAE,IAAI,CAACL,KAAK,CAAC,eAAe,CAAC;IACzD;EACF,CAAC;EACDM,OAAOA,CAAA,EAAG;IACRC,QAAQ,CAACC,gBAAgB,CAAC,SAAS,EAAE,IAAI,CAACL,eAAe,CAAC;IAC1DM,OAAO,CAACC,GAAG,CAAC,iCAAiC,EAAE,IAAI,CAACb,YAAY,CAAC;EACnE,CAAC;EACDc,SAASA,CAAA,EAAG;IACVJ,QAAQ,CAACK,mBAAmB,CAAC,SAAS,EAAE,IAAI,CAACT,eAAe,CAAC;EAC/D;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}